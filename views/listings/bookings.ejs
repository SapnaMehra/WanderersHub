<% layout("/layouts/boilerplate") -%>

<div class="container mt-4">
  <h2>My Bookings 🧳</h2>

  <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 mt-3">

    <% if (allBookings.length === 0) { %>

      <div class="col">
        <p>You don't have any bookings yet.</p>
      </div>

    <% } else { %>

      <% for (let booking of allBookings) { %>

        <div class="col mb-4">

          <div class="card border-0">

            <img
              src="<%= booking.listing.image.url %>"
              class="card-img-top"
              alt="listing_image"
              style="height: 20rem; object-fit: cover"
            >

            <div class="card-body">

              <h5 class="card-title">
                <%= booking.listing.title %>
              </h5>

              <p class="card-text">
                📍 <%= booking.listing.location %>
              </p>

              <p class="card-text">
                📅 Check-in:
                <%= booking.checkIn.toLocaleDateString("en-IN") %>
              </p>

              <p class="card-text">
                📅 Check-out:
                <%= booking.checkOut.toLocaleDateString("en-IN") %>
              </p>

              <p class="card-text">
                👥 Guests: <%= booking.guests %>
              </p>
              <p class="card-text">
  💰 Total Price: ₹<%= (booking.totalPrice || 0).toLocaleString("en-IN") %>
</p><p class="card-text">
  📌 Status:
  <strong><%= booking.status %></strong>
</p>

              <a
                href="/listings/<%= booking.listing._id %>"
                class="btn btn-dark"
              >
                View Listing
              </a>
              <form
  action="/bookings/<%= booking._id %>/cancel"
  method="POST"
  class="mt-2"
>
  <button type="submit" class="btn btn-danger">
    Cancel Booking
  </button>
</form>

            </div>

          </div>

        </div>

      <% } %>

    <% } %>

  </div>
</div>